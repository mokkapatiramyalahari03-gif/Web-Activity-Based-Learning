<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sweet Treats Bakery</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #fff0f5;
            color: #4e342e;
        }

        header {
            background-color: #ad1457;
            color: white;
            text-align: center;
            padding: 30px;
        }

        nav {
            background-color: #880e4f;
            text-align: center;
            padding: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        nav a:hover {
            color: #ffccbc;
        }

        .banner {
            background-color: #f8bbd0;
            text-align: center;
            padding: 35px 20px;
        }

        h2 {
            color: #ad1457;
            text-align: center;
        }

        .products {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            padding: 25px;
        }

        .card {
            background: white;
            width: 230px;
            text-align: center;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 3px 10px #e0b9c9;
            transition: transform 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .cake {
            font-size: 60px;
        }

        .price {
            color: #ad1457;
            font-size: 18px;
            font-weight: bold;
        }

        button {
            background-color: #ad1457;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 6px;
            cursor: pointer;
        }

        button:hover {
            background-color: #880e4f;
        }

        section {
            padding: 20px;
        }

        footer {
            background-color: #880e4f;
            color: white;
            text-align: center;
            padding: 18px;
        }

        @media (max-width: 600px) {
            nav a {
                display: inline-block;
                margin: 8px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>🎂 Sweet Treats Bakery</h1>
        <p>Making Every Celebration Sweeter!</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#cakes">Our Products</a>
        <a href="#offers">Offers</a>
        <a href="#contact">Contact</a>
    </nav>

    <div class="banner" id="home">
        <h2>Welcome to Sweet Treats</h2>
        <p>Fresh cakes, delicious cookies and tasty pastries.</p>
        <a href="#cakes">
            <button>Explore Our Bakery</button>
        </a>
    </div>

    <section id="cakes">
        <h2>Our Special Products</h2>

        <div class="products">
            <div class="card">
                <div class="cake">🎂</div>
                <h3>Chocolate Cake</h3>
                <p>Rich chocolate cream cake.</p>
                <p class="price">₹599</p>
                <button onclick="alert('Chocolate Cake selected!')">
                    Order Now
                </button>
            </div>

            <div class="card">
                <div class="cake">🧁</div>
                <h3>Cupcakes</h3>
                <p>Soft cupcakes with creamy toppings.</p>
                <p class="price">₹80</p>
                <button onclick="alert('Cupcakes selected!')">
                    Order Now
                </button>
            </div>

            <div class="card">
                <div class="cake">🍪</div>
                <h3>Cookies</h3>
                <p>Crunchy, freshly baked cookies.</p>
                <p class="price">₹120</p>
                <button onclick="alert('Cookies selected!')">
                    Order Now
                </button>
            </div>

            <div class="card">
                <div class="cake">🥐</div>
                <h3>Pastries</h3>
                <p>Soft and delicious cream pastries.</p>
                <p class="price">₹90</p>
                <button onclick="alert('Pastry selected!')">
                    Order Now
                </button>
            </div>
        </div>
    </section>

    <section id="offers" style="text-align:center;">
        <h2>Special Offers</h2>
        <p>Enjoy 15% off on selected birthday cake orders!</p>
        <p>Custom cakes are available on request.</p>
    </section>

    <section id="contact" style="text-align:center;">
        <h2>Contact Us</h2>
        <p>Email: sweettreats@example.com</p>
        <p>Phone: 9876543210</p>
        <p>Opening Hours: 8:00 AM - 9:00 PM</p>
    </section>

    <footer>
        <p>&copy; 2026 Sweet Treats Bakery</p>
        <p>Baked with Love!</p>
    </footer>

</body>
</html>
